{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "whatsradar.top" }],
      "destination": "https://zapradarbrasil.com.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.whatsradar.top" }],
      "destination": "https://zapradarbrasil.com.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.zapradarbrasil.com.br" }],
      "destination": "https://zapradarbrasil.com.br/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|webp|jpg|jpeg|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
